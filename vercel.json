{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "cleanUrls": true,
  "trailingSlash": false,
  "env": {
    "NODE_VERSION": "18"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/chatbot",
      "destination": "/api/chatbot.js"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/post/:id",
      "destination": "/post/post-:id.html"
    }
  ],
  "redirects": [
    {
      "source": "/bodas",
      "destination": "https://marketing-celula.vercel.app/bodas",
      "permanent": true
    },
    {
      "source": "/xv",
      "destination": "https://marketing-celula.vercel.app/xv",
      "permanent": true
    },
    {
      "source": "/privada",
      "destination": "https://marketing-celula.vercel.app/privada",
      "permanent": true
    },
    {
      "source": "/cotizador.html",
      "destination": "/cotizador",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/testimonios.html",
      "destination": "/testimonios",
      "permanent": true
    },
    {
      "source": "/post/post-:id.html",
      "destination": "/post/:id",
      "permanent": true
    }
  ]
}
