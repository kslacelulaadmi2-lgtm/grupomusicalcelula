{
  "version": "2.10",
  "themes": {
    "mode": ["light", "dark"],
    "spacing": ["regular", "condensed"]
  },
  "variables": {
    "color.background": { "type": "color", "value": "#111827" },
    "color.card.bg": { "type": "color", "value": "#111827" },
    "color.card.border": { "type": "color", "value": "#374151" },
    "color.text": { "type": "color", "value": "#E5E7EB" },
    "color.text.primary": { "type": "color", "value": "#FFFFFF" },
    "color.text.secondary": { "type": "color", "value": "#9CA3AF" },
    "color.accent.blue": { "type": "color", "value": "#2563EB" },
    "color.accent.yellow": { "type": "color", "value": "#FACC15" },
    "color.accent.orange": { "type": "color", "value": "#EA580C" },
    "size.radius": { "type": "number", "value": 8 },
    "size.radius.full": { "type": "number", "value": 9999 },
    "font.family.primary": { "type": "string", "value": "Montserrat" }
  },
  "children": [
    {
      "id": "business-card",
      "type": "frame",
      "x": 100,
      "y": 50,
      "width": 800,
      "layout": "vertical",
      "fill": "#111827",
      "cornerRadius": 8,
      "stroke": { "align": "inside", "thickness": 1, "fill": "#374151" },
      "effect": [{ "type": "shadow", "shadowType": "outer", "offset": { "x": 0, "y": 20 }, "blur": 25, "color": "rgba(0, 0, 0, 0.1)" }],
      "children": [
        {
          "id": "business-header",
          "type": "frame",
          "padding": [24, 24, 24, 24],
          "layout": "horizontal",
          "gap": 24,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#374151" },
          "children": [
            { "id": "business-logo", "type": "rectangle", "width": 184, "height": 128, "fill": "assets/logo/Logo-grupo-musical-la-celula.webp", "cornerRadius": 8 },
            {
              "id": "business-info",
              "type": "frame",
              "layout": "vertical",
              "gap": 8,
              "children": [
                { "id": "business-name", "type": "text", "textGrowth": "auto", "content": "Grupo Musical Versátil La Célula", "fontSize": 30, "fontWeight": "bold", "fill": "#FFFFFF" },
                {
                  "id": "business-rating",
                  "type": "frame",
                  "layout": "horizontal",
                  "gap": 8,
                  "alignItems": "center",
                  "children": [
                    { "id": "rating-value", "type": "text", "textGrowth": "auto", "content": "4.9", "fontSize": 18, "fontWeight": "bold", "fill": "#E5E7EB" },
                    { "id": "rating-stars", "type": "text", "textGrowth": "auto", "content": "★★★★★", "fontSize": 16, "fill": "#FACC15" },
                    { "id": "rating-count", "type": "text", "textGrowth": "auto", "content": "(17 opiniones)", "fontSize": 14, "fill": "#9CA3AF" }
                  ]
                },
                { "id": "business-type", "type": "text", "textGrowth": "auto", "content": "Grupo musical", "fontSize": 14, "fill": "#9CA3AF" }
              ]
            }
          ]
        },
        {
          "id": "business-actions",
          "type": "frame",
          "padding": [24, 24, 24, 24],
          "layout": "horizontal",
          "gap": 12,
          "children": [
            { "id": "btn-website", "type": "frame", "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "gap": 8, "padding": [8, 16, 8, 16], "fill": "#2563EB", "cornerRadius": 9999, "children": [
              { "id": "btn-website-text", "type": "text", "textGrowth": "auto", "content": "🌐 Sitio web", "fontSize": 14, "fontWeight": 600, "fill": "#FFFFFF" }
            ]},
            { "id": "btn-save", "type": "frame", "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "gap": 8, "padding": [8, 16, 8, 16], "fill": "#374151", "cornerRadius": 9999, "children": [
              { "id": "btn-save-text", "type": "text", "textGrowth": "auto", "content": "🧭 Guardar", "fontSize": 14, "fontWeight": 600, "fill": "#FFFFFF" }
            ]},
            { "id": "btn-call", "type": "frame", "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "gap": 8, "padding": [8, 16, 8, 16], "fill": "#374151", "cornerRadius": 9999, "children": [
              { "id": "btn-call-text", "type": "text", "textGrowth": "auto", "content": "📞 Llamar", "fontSize": 14, "fontWeight": 600, "fill": "#FFFFFF" }
            ]}
          ]
        },
        {
          "id": "reviews-header",
          "type": "frame",
          "padding": [24, 24, 24, 24],
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            { "id": "reviews-title", "type": "text", "textGrowth": "auto", "content": "Opiniones", "fontSize": 24, "fontWeight": "bold", "fill": "#FFFFFF" },
            { "id": "btn-write-review", "type": "frame", "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "padding": [8, 16, 8, 16], "fill": "#2563EB", "cornerRadius": 8, "children": [
              { "id": "btn-review-text", "type": "text", "textGrowth": "auto", "content": "Escribir una opinión", "fontSize": 14, "fontWeight": 600, "fill": "#FFFFFF" }
            ]}
          ]
        },
        {
          "id": "reviews-list",
          "type": "frame",
          "padding": [24, 24, 24, 24],
          "layout": "vertical",
          "gap": 32,
          "children": [
            {
              "id": "review-1",
              "type": "frame",
              "layout": "horizontal",
              "gap": 16,
              "children": [
                { "id": "review-1-avatar", "type": "ellipse", "width": 40, "height": 40, "fill": "#4B5563" },
                {
                  "id": "review-1-content",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    { "id": "review-1-name", "type": "text", "textGrowth": "auto", "content": "Pedro Martin Lozano Morales", "fontSize": 16, "fontWeight": "bold", "fill": "#E5E7EB" },
                    { "id": "review-1-meta", "type": "frame", "layout": "horizontal", "gap": 8, "alignItems": "center", "children": [
                      { "id": "review-1-stars", "type": "text", "textGrowth": "auto", "content": "★★★★★", "fontSize": 14, "fill": "#FACC15" },
                      { "id": "review-1-date", "type": "text", "textGrowth": "auto", "content": "· hace un año", "fontSize": 12, "fill": "#9CA3AF" }
                    ]},
                    { "id": "review-1-text", "type": "text", "textGrowth": "fixed-width", "width": 680, "content": "\"Excelente grupo tocan música versátil para todos los gustos 100% recomendable para cualquier tipo de evento\"", "fontSize": 14, "fill": "#E5E7EB" },
                    { "id": "review-1-response", "type": "frame", "padding": [12, 12, 12, 12], "layout": "vertical", "gap": 4, "stroke": { "align": "inside", "thickness": 2, "fill": "#4B5563" }, "children": [
                      { "id": "review-1-response-label", "type": "text", "textGrowth": "auto", "content": "Respuesta del propietario", "fontSize": 12, "fontWeight": "bold", "fill": "#9CA3AF" },
                      { "id": "review-1-response-text", "type": "text", "textGrowth": "fixed-width", "width": 640, "content": "\"Muchas gracias Pedro, nos alimenta saber que notan el gran esfuerzo que hacemos.\"", "fontSize": 12, "fill": "#9CA3AF", "fontStyle": "italic" }
                    ]}
                  ]
                }
              ]
            },
            {
              "id": "review-2",
              "type": "frame",
              "layout": "horizontal",
              "gap": 16,
              "children": [
                { "id": "review-2-avatar", "type": "ellipse", "width": 40, "height": 40, "fill": "#4B5563" },
                {
                  "id": "review-2-content",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    { "id": "review-2-name", "type": "text", "textGrowth": "auto", "content": "Rubicel Trujillo", "fontSize": 16, "fontWeight": "bold", "fill": "#E5E7EB" },
                    { "id": "review-2-meta", "type": "frame", "layout": "horizontal", "gap": 8, "alignItems": "center", "children": [
                      { "id": "review-2-badge", "type": "frame", "padding": [2, 6, 2, 6], "fill": "#EA580C", "cornerRadius": 4, "children": [{ "id": "badge-text", "type": "text", "textGrowth": "auto", "content": "Local Guide", "fontSize": 10, "fontWeight": 600, "fill": "#FFFFFF" }] },
                      { "id": "review-2-stars", "type": "text", "textGrowth": "auto", "content": "★★★★★", "fontSize": 14, "fill": "#FACC15" },
                      { "id": "review-2-date", "type": "text", "textGrowth": "auto", "content": "· hace 5 años", "fontSize": 12, "fill": "#9CA3AF" }
                    ]},
                    { "id": "review-2-text", "type": "text", "textGrowth": "fixed-width", "width": 680, "content": "\"Excelente grupo musical. Muy versátil, excelente repertorio musical. A todos nuestros invitados les encantó todo.\"", "fontSize": 14, "fill": "#E5E7EB" }
                  ]
                }
              ]
            },
            {
              "id": "review-3",
              "type": "frame",
              "layout": "horizontal",
              "gap": 16,
              "children": [
                { "id": "review-3-avatar", "type": "ellipse", "width": 40, "height": 40, "fill": "#4B5563" },
                {
                  "id": "review-3-content",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    { "id": "review-3-name", "type": "text", "textGrowth": "auto", "content": "Aura Mora", "fontSize": 16, "fontWeight": "bold", "fill": "#E5E7EB" },
                    { "id": "review-3-meta", "type": "frame", "layout": "horizontal", "gap": 8, "alignItems": "center", "children": [
                      { "id": "review-3-stars", "type": "text", "textGrowth": "auto", "content": "★★★★★", "fontSize": 14, "fill": "#FACC15" },
                      { "id": "review-3-date", "type": "text", "textGrowth": "auto", "content": "· hace 2 años", "fontSize": 12, "fill": "#9CA3AF" }
                    ]},
                    { "id": "review-3-text", "type": "text", "textGrowth": "fixed-width", "width": 680, "content": "\"Súper profesionales, me encantó que desde el primer momento me brindaron una excelente atención.\"", "fontSize": 14, "fill": "#E5E7EB" }
                  ]
                }
              ]
            },
            {
              "id": "review-4",
              "type": "frame",
              "layout": "horizontal",
              "gap": 16,
              "children": [
                { "id": "review-4-avatar", "type": "ellipse", "width": 40, "height": 40, "fill": "#4B5563" },
                {
                  "id": "review-4-content",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    { "id": "review-4-name", "type": "text", "textGrowth": "auto", "content": "Erandi MM", "fontSize": 16, "fontWeight": "bold", "fill": "#E5E7EB" },
                    { "id": "review-4-meta", "type": "frame", "layout": "horizontal", "gap": 8, "alignItems": "center", "children": [
                      { "id": "review-4-badge", "type": "frame", "padding": [2, 6, 2, 6], "fill": "#EA580C", "cornerRadius": 4, "children": [{ "id": "badge-text-2", "type": "text", "textGrowth": "auto", "content": "Local Guide", "fontSize": 10, "fontWeight": 600, "fill": "#FFFFFF" }] },
                      { "id": "review-4-stars", "type": "text", "textGrowth": "auto", "content": "★★★★★", "fontSize": 14, "fill": "#FACC15" },
                      { "id": "review-4-date", "type": "text", "textGrowth": "auto", "content": "· hace 5 años", "fontSize": 12, "fill": "#9CA3AF" }
                    ]},
                    { "id": "review-4-text", "type": "text", "textGrowth": "fixed-width", "width": 680, "content": "\"Excelente trabajo, todos nuestros invitados estuvieron encantados, muchas gracias por amenizar tan bien nuestra boda 🥰\"", "fontSize": 14, "fill": "#E5E7EB" }
                  ]
                }
              ]
            },
            {
              "id": "review-5",
              "type": "frame",
              "layout": "horizontal",
              "gap": 16,
              "children": [
                { "id": "review-5-avatar", "type": "ellipse", "width": 40, "height": 40, "fill": "#4B5563" },
                {
                  "id": "review-5-content",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    { "id": "review-5-name", "type": "text", "textGrowth": "auto", "content": "Kimberly Rocha", "fontSize": 16, "fontWeight": "bold", "fill": "#E5E7EB" },
                    { "id": "review-5-meta", "type": "frame", "layout": "horizontal", "gap": 8, "alignItems": "center", "children": [
                      { "id": "review-5-stars", "type": "text", "textGrowth": "auto", "content": "★★★★★", "fontSize": 14, "fill": "#FACC15" },
                      { "id": "review-5-date", "type": "text", "textGrowth": "auto", "content": "· hace 7 años", "fontSize": 12, "fill": "#9CA3AF" }
                    ]},
                    { "id": "review-5-text", "type": "text", "textGrowth": "fixed-width", "width": 680, "content": "\"Lo que más me encantó es que son super versátiles, un sonido que suena increíble y súper ambiente.\"", "fontSize": 14, "fill": "#E5E7EB" }
                  ]
                }
              ]
            },
            {
              "id": "review-6",
              "type": "frame",
              "layout": "horizontal",
              "gap": 16,
              "children": [
                { "id": "review-6-avatar", "type": "ellipse", "width": 40, "height": 40, "fill": "#4B5563" },
                {
                  "id": "review-6-content",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    { "id": "review-6-name", "type": "text", "textGrowth": "auto", "content": "Sebastián Vernis Mora", "fontSize": 16, "fontWeight": "bold", "fill": "#E5E7EB" },
                    { "id": "review-6-meta", "type": "frame", "layout": "horizontal", "gap": 8, "alignItems": "center", "children": [
                      { "id": "review-6-stars", "type": "text", "textGrowth": "auto", "content": "★★★★★", "fontSize": 14, "fill": "#FACC15" },
                      { "id": "review-6-date", "type": "text", "textGrowth": "auto", "content": "· hace 2 años", "fontSize": 12, "fill": "#9CA3AF" }
                    ]},
                    { "id": "review-6-text", "type": "text", "textGrowth": "fixed-width", "width": 680, "content": "\"Los amé. Música desde los 80's y 90's hasta actual, estuvimos bailando sin parar.\"", "fontSize": 14, "fill": "#E5E7EB" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
