{
  "version": "2.10",
  "themes": {
    "mode": ["light", "dark"],
    "spacing": ["regular", "condensed"]
  },
  "variables": {
    "color.background": { "type": "color", "value": "#000000" },
    "color.primary": { "type": "color", "value": "#FFD700" },
    "color.text": { "type": "color", "value": "#FFFFFF" },
    "color.text.secondary": { "type": "color", "value": "#D1D5DB" },
    "color.accent.green": { "type": "color", "value": "#25D366" },
    "color.header.bg": { "type": "color", "value": "rgba(0, 0, 0, 0.4)" },
    "size.radius": { "type": "number", "value": 5 },
    "size.radius.pill": { "type": "number", "value": 50 },
    "font.family.primary": { "type": "string", "value": "Open Sans" },
    "font.family.display": { "type": "string", "value": "Lobster" }
  },
  "children": [
    {
      "id": "header",
      "type": "frame",
      "reusable": true,
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 55,
      "layout": "horizontal",
      "justifyContent": "center",
      "alignItems": "center",
      "fill": "$color.header.bg",
      "effect": [{ "type": "background_blur", "radius": 10 }],
      "children": [
        {
          "id": "nav-container",
          "type": "frame",
          "width": 980,
          "layout": "horizontal",
          "justifyContent": "center",
          "gap": 40,
          "children": [
            { "id": "nav-inicio", "type": "text", "textGrowth": "auto", "content": "INICIO", "fontSize": 15, "fontWeight": "bold", "fill": "$color.text" },
            { "id": "nav-cotizador", "type": "text", "textGrowth": "auto", "content": "COTIZADOR", "fontSize": 15, "fontWeight": "bold", "fill": "$color.text" },
            { "id": "nav-blog", "type": "text", "textGrowth": "auto", "content": "BLOG", "fontSize": 15, "fontWeight": "bold", "fill": "$color.text" }
          ]
        }
      ]
    },
    {
      "id": "hero-section",
      "type": "frame",
      "x": 0,
      "y": 55,
      "width": 1440,
      "height": 800,
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "fill": "#111111",
      "children": [
        {
          "id": "hero-content",
          "type": "frame",
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 20,
          "children": [
            { "id": "hero-logo", "type": "rectangle", "width": 390, "height": 220, "fill": "assets/images/logo-blanco.webp" },
            { "id": "hero-title", "type": "text", "textGrowth": "fixed-width", "width": 800, "content": "Eventos corporativos de élite para tu empresa.", "fontSize": 48, "fontWeight": 700, "fill": "$color.text", "fontFamily": "$font.family.display", "textAlign": "center" },
            {
              "id": "hero-pill",
              "type": "frame",
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "padding": [14, 28, 14, 28],
              "fill": "#FFD700",
              "cornerRadius": 50,
              "effect": [{ "type": "shadow", "shadowType": "outer", "offset": { "x": 0, "y": 4 }, "blur": 20, "color": "rgba(255, 215, 0, 0.4)" }],
              "children": [
                { "id": "pill-text", "type": "text", "textGrowth": "auto", "content": "✨ Garantía de Fiesta: Sin caídas de ritmo", "fontSize": 18, "fontWeight": "bold", "fill": "#000000" }
              ]
            },
            {
              "id": "cta-button",
              "type": "frame",
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "gap": 10,
              "padding": [18, 40, 18, 40],
              "fill": "#25D366",
              "cornerRadius": 50,
              "effect": [{ "type": "shadow", "shadowType": "outer", "offset": { "x": 0, "y": 4 }, "blur": 20, "color": "rgba(37, 211, 102, 0.5)" }],
              "children": [
                { "id": "cta-text", "type": "text", "textGrowth": "auto", "content": "💬 COTIZAR EVENTO", "fontSize": 18, "fontWeight": "bold", "fill": "#FFFFFF" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "manifesto-section",
      "type": "frame",
      "x": 0,
      "y": 855,
      "width": 1440,
      "padding": [60, 100, 60, 100],
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 20,
      "children": [
        { "id": "manifesto-title", "type": "text", "textGrowth": "fixed-width", "width": 1200, "content": "Nuestra Filosofía de Entretenimiento", "fontSize": 32, "fontWeight": "bold", "fill": "$color.text", "textAlign": "center" },
        { "id": "manifesto-quote", "type": "text", "textGrowth": "fixed-width", "width": 1000, "content": "\"En La Célula no solo tocamos música; diseñamos la atmósfera de tu evento corporativo para proyectar la mejor imagen de tu marca.\"", "fontSize": 18, "fontWeight": 600, "fill": "$color.text.secondary", "textAlign": "center", "lineHeight": 1.6 },
        { "id": "manifesto-author", "type": "text", "textGrowth": "auto", "content": "— Dirección General, La Célula.", "fontSize": 14, "fill": "$color.text.secondary", "fontStyle": "italic", "textAlign": "center" }
      ]
    },
    {
      "id": "servicios-section",
      "type": "frame",
      "x": 0,
      "y": 1100,
      "width": 1440,
      "padding": [60, 100, 60, 100],
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 30,
      "children": [
        { "id": "section-title", "type": "text", "textGrowth": "auto", "content": "Eventos Corporativos de Élite", "fontSize": 36, "fontWeight": "bold", "fill": "$color.text", "textAlign": "center" },
        { "id": "section-subtitle", "type": "text", "textGrowth": "auto", "content": "Distinción y profesionalismo para tu marca", "fontSize": 20, "fontWeight": 600, "fill": "$color.text.secondary", "textAlign": "center" },
        { "id": "section-description", "type": "text", "textGrowth": "fixed-width", "width": 800, "content": "Logística impecable para eventos empresariales de alto nivel.", "fontSize": 16, "fill": "$color.text.secondary", "textAlign": "center" },
        {
          "id": "service-card",
          "type": "frame",
          "width": 600,
          "layout": "vertical",
          "fill": "#111827",
          "cornerRadius": 12,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#374151" },
          "children": [
            { "id": "service-image", "type": "rectangle", "width": 600, "height": 200, "fill": "assets/images/servicio-boda.webp" },
            {
              "id": "service-content",
              "type": "frame",
              "padding": [20, 20, 20, 20],
              "layout": "vertical",
              "gap": 12,
              "children": [
                { "id": "service-title", "type": "text", "textGrowth": "auto", "content": "Eventos Corporativos de Élite", "fontSize": 24, "fontWeight": "bold", "fill": "$color.text" },
                { "id": "service-description", "type": "text", "textGrowth": "fixed-width", "width": 560, "content": "Distinción y profesionalismo para tu marca. Logística impecable.", "fontSize": 14, "fill": "$color.text.secondary" },
                {
                  "id": "service-features",
                  "type": "frame",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    { "id": "feature-1", "type": "text", "textGrowth": "auto", "content": "✓ Show 80's o temático", "fontSize": 13, "fill": "$color.text.secondary" },
                    { "id": "feature-2", "type": "text", "textGrowth": "auto", "content": "✓ Equipo hasta 10,000 personas", "fontSize": 13, "fill": "$color.text.secondary" },
                    { "id": "feature-3", "type": "text", "textGrowth": "auto", "content": "✓ Escenario y video", "fontSize": 13, "fill": "$color.text.secondary" },
                    { "id": "feature-4", "type": "text", "textGrowth": "auto", "content": "✓ Luz robótica y láser", "fontSize": 13, "fill": "$color.text.secondary" },
                    { "id": "feature-5", "type": "text", "textGrowth": "auto", "content": "✓ Pantallas gigantes", "fontSize": 13, "fill": "$color.text.secondary" },
                    { "id": "feature-6", "type": "text", "textGrowth": "auto", "content": "✓ Animadores / DJ", "fontSize": 13, "fill": "$color.text.secondary" }
                  ]
                },
                {
                  "id": "service-cta",
                  "type": "frame",
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "padding": [12, 24, 12, 24],
                  "fill": "$color.primary",
                  "cornerRadius": 50,
                  "children": [
                    { "id": "cta-text-2", "type": "text", "textGrowth": "auto", "content": "Cotiza tu paquete", "fontSize": 16, "fontWeight": "bold", "fill": "#000000" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "footer",
      "type": "frame",
      "x": 0,
      "y": 1700,
      "width": 1440,
      "padding": [40, 100, 40, 100],
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 20,
      "fill": "#0A0A0A",
      "children": [
        {
          "id": "footer-social",
          "type": "frame",
          "layout": "horizontal",
          "gap": 15,
          "justifyContent": "center",
          "children": [
            { "id": "social-whatsapp", "type": "ellipse", "width": 39, "height": 39, "fill": "$color.accent.green" },
            { "id": "social-facebook", "type": "ellipse", "width": 39, "height": 39, "fill": "#1877F2" },
            { "id": "social-youtube", "type": "ellipse", "width": 39, "height": 39, "fill": "#FF0000" }
          ]
        },
        { "id": "footer-copyright", "type": "text", "textGrowth": "auto", "content": "© 2024 Grupo Musical Versátil La Célula. Todos los derechos reservados.", "fontSize": 12, "fill": "#6B7280", "textAlign": "center" }
      ]
    }
  ]
}
