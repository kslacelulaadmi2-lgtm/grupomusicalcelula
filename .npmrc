# Configuración para Cloudflare Pages
# Asegura que las dependencias se instalen correctamente durante el build

# Usar lockfile si existe
package-lock=true

# Permitir instalación en producción
production=false

# No verificar certificados en CI (solo si es necesario)
# strict-ssl=false

# Legacy peer deps (por si hay conflictos de dependencias)
legacy-peer-deps=false

# Guardar exactas las versiones
save-exact=false

# Engine strict
engine-strict=false
