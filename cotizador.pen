{
  "version": "2.10",
  "themes": {
    "mode": ["light", "dark"],
    "spacing": ["regular", "condensed"]
  },
  "variables": {
    "color.background": { "type": "color", "value": "#000000" },
    "color.primary": { "type": "color", "value": "#FFD700" },
    "color.text": { "type": "color", "value": "#FFFFFF" },
    "color.text.secondary": { "type": "color", "value": "#D1D5DB" },
    "color.accent.green": { "type": "color", "value": "#25D366" },
    "color.header.bg": { "type": "color", "value": "rgba(0, 0, 0, 0.4)" },
    "color.input.bg": { "type": "color", "value": "#1F2937" },
    "color.input.border": { "type": "color", "value": "#374151" },
    "size.radius": { "type": "number", "value": 5 },
    "size.radius.pill": { "type": "number", "value": 50 },
    "size.radius.input": { "type": "number", "value": 8 },
    "font.family.primary": { "type": "string", "value": "Open Sans" }
  },
  "children": [
    {
      "id": "header",
      "type": "frame",
      "reusable": true,
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 55,
      "layout": "horizontal",
      "justifyContent": "center",
      "alignItems": "center",
      "fill": "$color.header.bg",
      "effect": [{ "type": "background_blur", "radius": 10 }],
      "children": [
        {
          "id": "nav-container",
          "type": "frame",
          "width": 980,
          "layout": "horizontal",
          "justifyContent": "center",
          "gap": 40,
          "children": [
            { "id": "nav-inicio", "type": "text", "textGrowth": "auto", "content": "INICIO", "fontSize": 15, "fontWeight": "bold", "fill": "$color.text" },
            { "id": "nav-cotizador", "type": "text", "textGrowth": "auto", "content": "COTIZADOR", "fontSize": 15, "fontWeight": "bold", "fill": "$color.primary" },
            { "id": "nav-blog", "type": "text", "textGrowth": "auto", "content": "BLOG", "fontSize": 15, "fontWeight": "bold", "fill": "$color.text" }
          ]
        }
      ]
    },
    {
      "id": "trust-section",
      "type": "frame",
      "x": 0,
      "y": 100,
      "width": 1440,
      "padding": [50, 20, 50, 20],
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 30,
      "children": [
        { "id": "trust-title", "type": "text", "textGrowth": "auto", "content": "¿Por qué elegirnos?", "fontSize": 28, "fontWeight": 700, "fill": "$color.primary", "textAlign": "center" },
        {
          "id": "trust-items",
          "type": "frame",
          "layout": "horizontal",
          "justifyContent": "center",
          "gap": 30,
          "children": [
            { "id": "trust-item-1", "type": "frame", "width": 280, "layout": "vertical", "justifyContent": "center", "alignItems": "center", "gap": 10, "children": [
              { "id": "trust-icon-1", "type": "text", "textGrowth": "auto", "content": "🎤", "fontSize": 40, "textAlign": "center" },
              { "id": "trust-text-1", "type": "text", "textGrowth": "fixed-width", "width": 280, "content": "Trayectoria comprobada en los recintos más exclusivos de la CDMX.", "fontSize": 16, "fill": "$color.text", "textAlign": "center" }
            ]},
            { "id": "trust-item-2", "type": "frame", "width": 280, "layout": "vertical", "justifyContent": "center", "alignItems": "center", "gap": 10, "children": [
              { "id": "trust-icon-2", "type": "text", "textGrowth": "auto", "content": "💃", "fontSize": 40, "textAlign": "center" },
              { "id": "trust-text-2", "type": "text", "textGrowth": "fixed-width", "width": 280, "content": "Energía explosiva que conecta con cada invitado.", "fontSize": 16, "fill": "$color.text", "textAlign": "center" }
            ]},
            { "id": "trust-item-3", "type": "frame", "width": 280, "layout": "vertical", "justifyContent": "center", "alignItems": "center", "gap": 10, "children": [
              { "id": "trust-icon-3", "type": "text", "textGrowth": "auto", "content": "🎉", "fontSize": 40, "textAlign": "center" },
              { "id": "trust-text-3", "type": "text", "textGrowth": "fixed-width", "width": 280, "content": "Expertos en crear momentos inolvidables: Bodas, XV Años y Eventos Corporativos.", "fontSize": 16, "fill": "$color.text", "textAlign": "center" }
            ]}
          ]
        },
        {
          "id": "trust-guarantee",
          "type": "frame",
          "width": 520,
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 10,
          "children": [
            { "id": "trust-icon-4", "type": "text", "textGrowth": "auto", "content": "🛡️", "fontSize": 40, "textAlign": "center" },
            { "id": "trust-text-4", "type": "text", "textGrowth": "fixed-width", "width": 520, "content": "¡Fiesta sin interrupciones! Olvídate de los baches de energía; la música no para.", "fontSize": 16, "fill": "$color.text", "textAlign": "center" }
          ]
        }
      ]
    },
    {
      "id": "venues-carousel",
      "type": "frame",
      "x": 0,
      "y": 300,
      "width": 1440,
      "padding": [40, 0, 40, 0],
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 30,
      "children": [
        { "id": "venues-title", "type": "text", "textGrowth": "auto", "content": "Lugares donde nos hemos presentado", "fontSize": 20, "fontWeight": 700, "fill": "$color.primary", "textAlign": "center" },
        {
          "id": "venues-track",
          "type": "frame",
          "layout": "horizontal",
          "gap": 60,
          "justifyContent": "center",
          "children": [
            { "id": "venue-1", "type": "rectangle", "width": 120, "height": 50, "fill": "#374151", "cornerRadius": 5 },
            { "id": "venue-2", "type": "rectangle", "width": 120, "height": 50, "fill": "#374151", "cornerRadius": 5 },
            { "id": "venue-3", "type": "rectangle", "width": 120, "height": 50, "fill": "#374151", "cornerRadius": 5 },
            { "id": "venue-4", "type": "rectangle", "width": 120, "height": 50, "fill": "#374151", "cornerRadius": 5 },
            { "id": "venue-5", "type": "rectangle", "width": 120, "height": 50, "fill": "#374151", "cornerRadius": 5 }
          ]
        }
      ]
    },
    {
      "id": "form-section",
      "type": "frame",
      "x": 0,
      "y": 500,
      "width": 1440,
      "padding": [60, 100, 60, 100],
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 30,
      "children": [
        { "id": "form-description", "type": "text", "textGrowth": "fixed-width", "width": 800, "content": "Completa el formulario y te contactaremos para brindarte un presupuesto personalizado.", "fontSize": 18, "fill": "$color.text", "textAlign": "center", "lineHeight": 1.6 },
        {
          "id": "form-container",
          "type": "frame",
          "width": 600,
          "padding": [32, 32, 32, 32],
          "layout": "vertical",
          "gap": 20,
          "fill": "#111827",
          "cornerRadius": 12,
          "effect": [{ "type": "shadow", "shadowType": "outer", "offset": { "x": 0, "y": 20 }, "blur": 25, "color": "rgba(0, 0, 0, 0.1)" }],
          "children": [
            { "id": "form-group-nombre", "type": "frame", "layout": "vertical", "gap": 8, "children": [
              { "id": "label-nombre", "type": "text", "textGrowth": "auto", "content": "Nombre completo *", "fontSize": 14, "fontWeight": 600, "fill": "$color.text" },
              { "id": "input-nombre", "type": "rectangle", "width": 536, "height": 44, "fill": "$color.input.bg", "cornerRadius": 8, "stroke": { "align": "inside", "thickness": 1, "fill": "$color.input.border" } }
            ]},
            { "id": "form-group-telefono", "type": "frame", "layout": "vertical", "gap": 8, "children": [
              { "id": "label-telefono", "type": "text", "textGrowth": "auto", "content": "Teléfono / WhatsApp *", "fontSize": 14, "fontWeight": 600, "fill": "$color.text" },
              { "id": "input-telefono", "type": "rectangle", "width": 536, "height": 44, "fill": "$color.input.bg", "cornerRadius": 8, "stroke": { "align": "inside", "thickness": 1, "fill": "$color.input.border" } }
            ]},
            { "id": "form-group-evento", "type": "frame", "layout": "vertical", "gap": 8, "children": [
              { "id": "label-evento", "type": "text", "textGrowth": "auto", "content": "Tipo de Evento *", "fontSize": 14, "fontWeight": 600, "fill": "$color.text" },
              { "id": "select-evento", "type": "rectangle", "width": 536, "height": 44, "fill": "$color.input.bg", "cornerRadius": 8, "stroke": { "align": "inside", "thickness": 1, "fill": "$color.input.border" } }
            ]},
            { "id": "form-submit", "type": "frame", "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "padding": [18, 24, 18, 24], "fill": "$color.accent.green", "cornerRadius": 8, "children": [
              { "id": "submit-text", "type": "text", "textGrowth": "auto", "content": "¡Quiero mi presupuesto!", "fontSize": 18, "fontWeight": 700, "fill": "#FFFFFF" }
            ]}
          ]
        },
        { "id": "contact-info", "type": "frame", "layout": "vertical", "justifyContent": "center", "alignItems": "center", "gap": 15, "children": [
          { "id": "contact-title", "type": "text", "textGrowth": "auto", "content": "¿Prefieres contactarnos por llamada?", "fontSize": 16, "fill": "$color.text", "textAlign": "center" },
          { "id": "contact-button", "type": "frame", "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "padding": [12, 24, 12, 24], "fill": "$color.accent.green", "cornerRadius": 8, "children": [
            { "id": "contact-btn-text", "type": "text", "textGrowth": "auto", "content": "📞 Llamar", "fontSize": 16, "fontWeight": 600, "fill": "#FFFFFF" }
          ]}
        ]}
      ]
    },
    {
      "id": "chatbot-widget",
      "type": "frame",
      "x": 1300,
      "y": 700,
      "width": 80,
      "height": 80,
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "children": [
        { "id": "chatbot-button", "type": "ellipse", "width": 60, "height": 60, "fill": "$color.accent.green", "effect": [{ "type": "shadow", "shadowType": "outer", "offset": { "x": 0, "y": 4 }, "blur": 12, "color": "rgba(37, 211, 102, 0.4)" }] },
        { "id": "chatbot-icon", "type": "text", "textGrowth": "auto", "content": "💬", "fontSize": 24, "textAlign": "center" }
      ]
    },
    {
      "id": "footer",
      "type": "frame",
      "x": 0,
      "y": 1000,
      "width": 1440,
      "padding": [40, 100, 40, 100],
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "gap": 20,
      "fill": "#0A0A0A",
      "children": [
        {
          "id": "footer-social",
          "type": "frame",
          "layout": "horizontal",
          "gap": 15,
          "justifyContent": "center",
          "children": [
            { "id": "social-whatsapp", "type": "ellipse", "width": 39, "height": 39, "fill": "$color.accent.green" },
            { "id": "social-facebook", "type": "ellipse", "width": 39, "height": 39, "fill": "#1877F2" },
            { "id": "social-youtube", "type": "ellipse", "width": 39, "height": 39, "fill": "#FF0000" },
            { "id": "social-twitter", "type": "ellipse", "width": 39, "height": 39, "fill": "#1DA1F2" }
          ]
        },
        { "id": "footer-copyright", "type": "text", "textGrowth": "auto", "content": "© 2025 Grupo Musical Versátil La Célula. Todos los derechos reservados.", "fontSize": 12, "fill": "#6B7280", "textAlign": "center" }
      ]
    }
  ]
}
